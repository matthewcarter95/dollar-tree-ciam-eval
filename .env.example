# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret

# App
APP_HOSTNAME=smitty.demo-connect.us
API_HOSTNAME=smitty-api.demo-connect.us
SESSION_SECRET=change_this_to_a_random_32char_string

# AWS
AWS_REGION=us-east-1
DYNAMODB_SESSIONS_TABLE=chatbot-sessions
DYNAMODB_CONVERSATIONS_TABLE=chatbot-conversations

# Auth0 Connection
# IMPORTANT: Use the connection NAME (e.g. "DT", "google-oauth2"), NOT the connection ID
# (con_xxx format). The /authorize endpoint accepts names only. Connection IDs cause
# "the connection is not enabled" errors even when the connection is correctly enabled.
# Leave blank to show the universal login with all configured connections.
AUTH0_CONNECTION=DT

# Bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
